<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <DevEnvLoc>$(MSBuildThisFileDirectory)DevEnv.targets</DevEnvLoc>
        <!-- Toolkit artifacts and intermediate files live under dist. -->
        <NebulaeArtifactsRoot Condition="'$(NebulaeArtifactsRoot)' == ''">$(MSBuildThisFileDirectory)dist\artifacts</NebulaeArtifactsRoot>
        <BaseIntermediateOutputPath Condition="'$(NebulaeToolkitBuild)' == 'true'">$(NebulaeArtifactsRoot)\cache\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
        <MSBuildProjectExtensionsPath Condition="'$(NebulaeToolkitBuild)' == 'true'">$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    </PropertyGroup>

    <!-- This sets $(DSPGameDir) -->
    <Import Project="$(DevEnvLoc)" Condition="Exists('$(DevEnvLoc)')"/>

    <PropertyGroup Label="Game Install Properties">
        <DSPGameDir Condition="!Exists('$(DevEnvLoc)')">C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program\</DSPGameDir>
        <DSPGameDir>$([MSBuild]::EnsureTrailingSlash('$(DSPGameDir)'))</DSPGameDir>
        <UseInstalledGameAssemblies Condition="'$(UseInstalledGameAssemblies)' == '' And Exists('$(DSPGameDir)DSPGAME_Data\Managed\Assembly-CSharp.dll')">true</UseInstalledGameAssemblies>
        <PluginOutputDirectory>$(DSPGameDir)BepInEx\plugins\Nebulae\</PluginOutputDirectory>
        <PropSheetPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</PropSheetPath>
        <SupportedDSPVersion>0.10.35.29151</SupportedDSPVersion>
        <PluginOutputDirectory Condition="'$(NebulaeToolkitBuild)' == 'true'">$(NebulaeArtifactsRoot)\build\$(Configuration)\Nebulae\</PluginOutputDirectory>
    </PropertyGroup>

    <PropertyGroup Label="Common Properties">
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Toolkit builds use isolated artifact directories. -->
        <OutputPath Condition="'$(NebulaeToolkitBuild)' == 'true' And '$(MSBuildProjectName)' != 'NebulaeTests'">$(PluginOutputDirectory)</OutputPath>
        <OutputPath Condition="'$(NebulaeToolkitBuild)' == 'true' And '$(MSBuildProjectName)' == 'NebulaeTests'">$(NebulaeArtifactsRoot)\tests\bin\$(Configuration)\</OutputPath>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <DefaultItemExcludes>$(DefaultItemExcludes);*.binlog;**/dist/**;**/bin/**;**/obj/**;**/TestResults/**;$(NebulaeArtifactsRoot)/**</DefaultItemExcludes>

        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <GitVersionBaseDirectory>$(MSBuildThisFileDirectory)</GitVersionBaseDirectory>
        <!-- NU1900 only reports that the vulnerability database could not be downloaded; it says
             nothing about the referenced packages themselves. -->
        <NoWarn>$(NoWarn);NU1900</NoWarn>
    </PropertyGroup>

    <!-- Shared Items -->
    <ItemGroup Label="NuGets">
        <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="Nerdbank.GitVersioning" Version="3.*" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Label="NuGetsMain">
        <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.*"/>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>..\Libs\Unity.TextMeshPro.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Label="Core">
        <PackageReference Include="BepInEx.Core" Version="5.4.17" PrivateAssets="all"/>
        <PackageReference Include="UnityEngine.Modules" Version="2022.3.53" IncludeAssets="compile" PrivateAssets="all"/>
        <PackageReference Include="DysonSphereProgram.GameLibs" Version="$(SupportedDSPVersion)-r.0" IncludeAssets="compile" PrivateAssets="all" Condition="'$(UseInstalledGameAssemblies)' != 'true'"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UseInstalledGameAssemblies)' == 'true'">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(NebulaeArtifactsRoot)\cache\compat-refs\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(NebulaeArtifactsRoot)\cache\compat-refs\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>
</Project>
