# Nebulae (Dyson Sphere Program multiplayer mod) — project-specific ignores

.gitignore
# The MSTest project is part of the repository: a failing test must be visible in review.
# (bin/obj are covered by the generic build-output rules above.)

# Local dev environment: Steam/DSP install paths (template: DevEnv.targets.example)
DevEnv.targets

# Local, versioned game decompilation (never ship game source or resources).
/GameDecompiled/

# Local development tools and generated output
tools/
dist/
*.binlog

# Syncthing local-only files: folder marker and per-machine ignore rules
.stfolder/
.stignore

# Local scratch output from ad-hoc commands: `nul` is what a stray `> nul` redirect creates on
# Windows, and test_out.txt is a captured console log. Neither belongs in history.
/nul
/test_out.txt

# StepCode workspace (agent session state, plans, workflow runs)
.stepcode/

# ---- .NET build output ----
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
*.log
*.tmp
*.pdb
*.[Cc]ache

# ---- IDE / editor ----
.vs/
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---- Tests / coverage ----
[Tt]est[Rr]esult*/
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# ---- NuGet ----
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# ---- Node / Python tooling ----
node_modules/
__pycache__/
*.pyc

# ---- Unity ----
# Unity .meta files are re-included inside NebulaeUnity via NebulaeUnity/.gitignore.
# NOTE: keep these as whole-directory excludes; using dir/* would let the deeper
# !/[Aa]ssets/**/*.meta rule re-include the build-output .meta files inside them.
*.meta
NebulaeUnity/Assets/Assemblies
NebulaeUnity/Assets/StreamingAssets/AssetBundles
NebulaeUnity/Assets/Plugins/Editor/JetBrains
NebulaeUnity/Assets/Plugins/Editor/JetBrains.meta
NebulaeUnity/Assets/Plugins.meta
NebulaeUnity/Assets/Plugins

# ---- Nerdbank.GitVersioning prepare-release ----
.store/
nbgv.exe
