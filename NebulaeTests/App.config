<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- This machine's Internet zone mapping marks file: URLs as remote, so the default
         LoadFrom path refuses the MSTest adapter and the game assemblies. The test host
         only runs in-process code from this repository. -->
    <loadFromRemoteSources enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Unity 2022's references use netstandard 2.1. These tests only use the CLR-compatible type/IL surface. -->
      <dependentAssembly>
        <assemblyIdentity name="netstandard" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.1.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
